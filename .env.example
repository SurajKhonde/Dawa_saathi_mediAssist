# ---- Telegram ----
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# ---- Anthropic Claude ----
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for the safety-critical IMAGE READING step (defaults to Sonnet for accuracy).
# Set to claude-haiku-4-5-20251001 to save cost if accuracy is good enough.
EXTRACTION_MODEL=claude-sonnet-4-6
# Model for generating the awareness text (cheaper is fine here).
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- Application ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=medbot
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=medbot

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Rate limiting ----
FREE_DAILY_SCAN_LIMIT=3

# ---- Caching ----
MEDICINE_CACHE_TTL_SECONDS=2592000

# ---- Image processing ----
MAX_IMAGE_BYTES=10485760

# ---- Safety ----
# Minimum confidence (0-1) in reading the medicine name/ingredients before we
# proceed. Below this, the user is asked for a clearer photo and their scan
# quota is NOT consumed. Keep strict for a medical app. Recommended 0.70-0.80.
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# Verify + enrich active ingredients against the openFDA database (true/false).
# Resilient: if FDA is down or the ingredient isn't found, the bot still works.
ENABLE_FDA_LOOKUP=true
